{
  "type": "github",
  "display_name": "GitHub Issues",
  "level": "full",
  "ref_pattern": "^(?:GH-|#)?(?:(?<repo>[A-Za-z0-9._-]+/[A-Za-z0-9._-]+)#)?(?<ref>[0-9]{1,9})$",
  "canonical_id": "GH-{ref}",
  "url_template": "https://github.com/{repo}/issues/{ref}",
  "required_config": ["repo"],
  "mcp": {
    "name": "github",
    "verified": false,
    "note": "Verify the official endpoint in phase 6 before writing it into any configuration."
  }
}
