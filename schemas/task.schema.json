{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChessWizard/wizrelay/schemas/task.schema.json",
  "title": "wizrelay task package descriptor",
  "description": "task.json: the machine-readable definition of one task package.",
  "type": "object",
  "required": ["schema_version", "id", "title", "version", "status", "roles", "scope"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": {
      "description": "Canonical identifier, e.g. CU-86c1abcd or GH-123.",
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["clickup", "github", "jira", "linear", "azure-devops", "none"]
        },
        "ref": { "type": "string", "maxLength": 200 },
        "url": { "type": "string", "maxLength": 2000 }
      }
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$", "maxLength": 60 },
    "version": { "type": "integer", "minimum": 0 },
    "status": { "type": "string", "enum": ["draft", "published", "archived"] },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "roles": {
      "description": "Free-form role names; the hub decides the catalogue.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 60 }
    },
    "repos": {
      "description": "Role to repository slug, used to build deep links.",
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 300 }
    },
    "enforcement": { "type": "string", "enum": ["strict", "ask", "off"] },
    "scope": {
      "description": "Per-role allow/deny globs, relative to the repository root.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["allow"],
        "properties": {
          "allow": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/glob" }
          },
          "deny": {
            "type": "array",
            "items": { "$ref": "#/$defs/glob" }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signals": { "$ref": "#/$defs/signals" },
        "role_signals": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/signals" }
        },
        "overrides": {
          "description": "Keyed by role, or '*' for every role.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/phaseOverrides" }
        }
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "summary"],
        "properties": {
          "version": { "type": "integer", "minimum": 0 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  },
  "$defs": {
    "glob": {
      "description": "Repository-relative glob. No absolute path, no drive letter, no '..'.",
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!~)(?!.*(^|/)\\.\\.($|/)).+$"
    },
    "level": { "type": "string", "enum": ["low", "medium", "high"] },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "complexity": { "$ref": "#/$defs/level" },
        "risk": { "$ref": "#/$defs/level" },
        "ambiguity": { "$ref": "#/$defs/level" },
        "kind": { "type": "string", "enum": ["mechanical"] }
      }
    },
    "phaseSetting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "enum": ["haiku", "sonnet", "opus", "opusplan", "fable", "inherit"] },
        "effort": { "type": "string", "enum": ["low", "medium", "high", "xhigh", "max"] },
        "advisor": { "type": "string", "enum": ["sonnet", "opus", "fable"] }
      }
    },
    "phaseOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan": { "$ref": "#/$defs/phaseSetting" },
        "implement": { "$ref": "#/$defs/phaseSetting" },
        "verify": { "$ref": "#/$defs/phaseSetting" },
        "ask": { "$ref": "#/$defs/phaseSetting" }
      }
    }
  }
}
